+    @Test
+    void codexFinalShouldCharacterizeExactAnalyzedNamePhrase() throws Exception {
+        Path p = source.resolve("final report draft.txt");
+        write(p, "unrelated payload");
+        try (LuceneIndexer ix = new LuceneIndexer(index,new IndexSettings())) { ix.upsertFile(p);ix.commit(); }
+        List<SearchResult> hits = service.search(new SearchRequest("report",100,null,SearchScope.NAME,MatchMode.EXACT));
