+    @Test
+    void codexReverifyShouldReadConfiguredTempIndexPathExactly() throws Exception {
+        Path base = org.abitware.docfinder.util.AppPaths.getBaseDir();
+        java.nio.file.Files.createDirectories(base);
+        Path config = base.resolve("config.properties");
+        byte[] previous = java.nio.file.Files.exists(config) ? java.nio.file.Files.readAllBytes(config) : null;
+        Path idx = java.nio.file.Paths.get(System.getProperty("java.io.tmpdir")).resolve("codex-roundtrip-index-" + System.nanoTime());
+        try {
+            // Exact config serialization used by the newly committed lifecycle test.
+            java.nio.file.Files.write(config, ("index.dir=" + idx.toAbsolutePath()).getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            assertEquals(idx.toAbsolutePath().normalize(), new org.abitware.docfinder.index.ConfigManager().getIndexDir(),
+                    "test fixture must index exactly under its declared temporary idx");
+        } finally {
+            if (previous == null) java.nio.file.Files.deleteIfExists(config);
+            else java.nio.file.Files.write(config, previous);
+        }
+    }
 }
