+            ix.upsertFile(b); ix.commit();
+        }
+        Resp scopedA = get("q=delta&directory=" + enc(sourceA.toString()));
+        assertEquals(200, scopedA.status);
+        assertFalse(scopedA.body.contains("delta-b.txt"), "scope A hides B even when B is committed");
