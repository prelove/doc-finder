+    @Test
+    void codexQaShouldClearPresentedResultsWhenServiceBecomesUnavailable() throws Exception {
+        FakeService fake=new FakeService();
+        fake.canned=Collections.singletonList(new SearchResult("old.txt","p/old.txt",1f,0,0,"name",1,false));
+        win=new HarnessWindow(fake);
+        setQuery(win,"alpha");invokeDoSearch(win);
+        assertTrue(waitForStatusPrefix("Results:",10000));
+        assertEquals(1,win.getResultTable().getRowCount());
+        onEdt(()->win.setSearchService(null));
+        invokeDoSearch(win);
+        assertEquals(0,win.getResultTable().getRowCount(),"unavailable search must clear earlier successful results");
+    }
+    @Test
+    void codexQaShouldClearPresentedResultsWhenFullRebuildFails() throws Exception {
+        FakeService fake=new FakeService();
+        fake.canned=Collections.singletonList(new SearchResult("old.txt","p/old.txt",1f,0,0,"name",1,false));
+        win=new HarnessWindow(fake);
+        setQuery(win,"alpha");invokeDoSearch(win);
+        assertTrue(waitForStatusPrefix("Results:",10000));
+        assertEquals(1,win.getResultTable().getRowCount());
+        onEdt(()->win.handleFullRebuildFailure());
+        assertEquals(0,win.getResultTable().getRowCount(),"rebuild failure must clear already rendered results");
+    }
+    @Test
+    void codexQaShouldNotSilentlyKeepOldServiceWhenOpeningNewLocationFails() throws Exception {
+        FakeService old=new FakeService();
+        win=new HarnessWindow(old);
+        win.openFailure=new RuntimeException("new location cannot open");
+        win.reopenSearchServiceAsync(java.nio.file.Paths.get("other-index"),new IndexSettings());
+        assertTrue(waitForStatus(expectedMsg(SearchException.Code.INDEX_UNAVAILABLE),10000));
+        assertNull(win.getCurrentSearchService(),"unavailable new location must not leave old service active");
+    }
+    private boolean waitForStatusPrefix(String prefix,long ms) throws Exception {
+        long deadline=System.currentTimeMillis()+ms;
+        while(System.currentTimeMillis()<deadline){
+            AtomicReference<String> text=new AtomicReference<>();
+            onEdt(()->text.set(win.getStatusLabel().getText()));
+            if(text.get().startsWith(prefix))return true;
+            Thread.sleep(50);
+        }
+        return false;
+    }
