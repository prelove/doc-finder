changes/**/evidence/**/*.patch whitespace=cr-at-eol,-blank-at-eol
changes/**/evidence/**/*.diff whitespace=cr-at-eol,-blank-at-eol
# Archival preserves the reviewed files' original EOF bytes.
changes/archive/*-add-directory-scoped-search/README.md whitespace=cr-at-eol,-blank-at-eof
changes/archive/*-add-directory-scoped-search/planning-validation.md whitespace=cr-at-eol,-blank-at-eof
