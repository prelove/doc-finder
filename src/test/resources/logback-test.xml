<configuration>
    <!-- Test-only logging: console only. The production FILE appender writes to
         ${user.dir}/.docfinder/logs and must never touch a real data directory
         during tests. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.apache.poi.xssf.usermodel.XSSFDrawing" level="ERROR"/>
    <logger name="org.apache.poi.ss.usermodel.DataFormatter" level="ERROR"/>

    <root level="warn">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
