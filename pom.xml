<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.abitware.docfinder</groupId>
  <artifactId>docfinder</artifactId>
  <version>3.0.0</version>
  <name>DocFinder</name>
  <description>Local /LAN file name/content search tool</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Empty default so the Surefire argLine composition below can safely
         append the isolated user.home last. External -DargLine=... values
         override this property and are preserved before the isolation args. -->
    <argLine></argLine>
  </properties>
  
  <dependencies>
	  <dependency>
	    <groupId>com.formdev</groupId>
	    <artifactId>flatlaf</artifactId>
	    <version>3.7.2</version>
	  </dependency>
	  <!-- IntelliJ theme pack（包含大量 .theme.json 对应的 LAF 类） -->
	  <dependency>
	    <groupId>com.formdev</groupId>
	    <artifactId>flatlaf-intellij-themes</artifactId>
	    <version>3.7.2</version>
	  </dependency>
	  <!-- 可选：切换主题时的平滑动画（没有也不影响功能） -->
	  <dependency>
	    <groupId>com.formdev</groupId>
	    <artifactId>flatlaf-extras</artifactId>
	    <version>3.7.2</version>
	    <optional>true</optional>
	  </dependency>
	  
	  <dependency>
	    <groupId>com.github.kwhat</groupId>
	    <artifactId>jnativehook</artifactId>
	    <version>2.2.2</version>
	  </dependency>

	  <!-- New dependencies for logging -->
	  <dependency>
	    <groupId>org.slf4j</groupId>
	    <artifactId>slf4j-api</artifactId>
	    <version>2.0.20</version>
	  </dependency>
	  <dependency>
	    <groupId>ch.qos.logback</groupId>
	    <artifactId>logback-classic</artifactId>
	    <version>1.6.6</version>
	  </dependency>
	  <!-- Log4j2 to SLF4J bridge -->
	  <dependency>
	    <groupId>org.apache.logging.log4j</groupId>
	    <artifactId>log4j-to-slf4j</artifactId>
	    <version>2.26.1</version>
	  </dependency>

	  <dependency>
	    <groupId>org.apache.lucene</groupId>
	    <artifactId>lucene-core</artifactId>
	    <version>10.6.0</version>
	  </dependency>
	  <dependency>
	    <groupId>org.apache.lucene</groupId>
	    <artifactId>lucene-analysis-common</artifactId>
	    <version>10.6.0</version>
	  </dependency>
	  <dependency>
	    <groupId>org.apache.lucene</groupId>
	    <artifactId>lucene-queryparser</artifactId>
	    <version>10.6.0</version>
	  </dependency>
	  
	  <dependency>
	    <groupId>org.apache.tika</groupId>
	    <artifactId>tika-core</artifactId>
	    <version>4.2.0</version>
	  </dependency>
	  <dependency>
	    <groupId>org.apache.tika</groupId>
	    <artifactId>tika-parsers-standard-package</artifactId>
	    <version>4.2.0</version>
	    <type>pom</type>
        <exclusions>
          <exclusion>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
          </exclusion>
        </exclusions>
	  </dependency>

	  <!-- Chinese analyzer -->
	  <dependency>
	    <groupId>org.apache.lucene</groupId>
	    <artifactId>lucene-analysis-smartcn</artifactId>
	    <version>10.6.0</version>
	  </dependency>
	  <!-- Japanese analyzer -->
	  <dependency>
	    <groupId>org.apache.lucene</groupId>
	    <artifactId>lucene-analysis-kuromoji</artifactId>
	    <version>10.6.0</version>
	  </dependency>
	  <dependency>
	    <groupId>org.junit.jupiter</groupId>
	    <artifactId>junit-jupiter</artifactId>
	    <version>6.1.3</version>
	    <scope>test</scope>
	  </dependency>
  </dependencies>

		
  <!--
    GraalVM native image profile.
    Prerequisites:
      1. Install GraalVM 21+ (Java 17+): https://www.graalvm.org/downloads/
      2. Run: gu install native-image
      3. Set GRAALVM_HOME / JAVA_HOME to the GraalVM JDK.
    Build:
      mvn -Pnative package
    Output: target/docfinder (Linux/macOS) or target/docfinder.exe (Windows)
    NOTE: The shaded-jar build and the native profile both target Java 21.
  -->
  <profiles>
    <profile>
      <id>native</id>
      <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>1.1.18</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
            <configuration>
              <mainClass>org.abitware.docfinder.App</mainClass>
              <imageName>docfinder</imageName>
              <buildArgs>
                <!-- Include all native-image configuration files bundled in the JAR -->
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                <!-- Swing requires AWT/headful mode -->
                <buildArg>-H:+AddAllCharsets</buildArg>
                <!-- Allow incomplete class path (some Tika parsers may be absent) -->
                <buildArg>--allow-incomplete-classpath</buildArg>
                <!-- Initialize Swing/AWT at run time, not build time -->
                <buildArg>--initialize-at-run-time=java.awt,javax.swing,sun.awt,sun.java2d,com.formdev.flatlaf</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <build>
	  <plugins>
	    <!-- Java 21 目标：release 同时约束语言级别与可见的 JDK API -->
	    <plugin>
	      <groupId>org.apache.maven.plugins</groupId>
	      <artifactId>maven-compiler-plugin</artifactId>
	      <version>3.16.0</version>
	      <configuration>
	        <release>21</release>
            <proc>none</proc>
	      </configuration>
	    </plugin>
	
	    <!-- 可执行 fat-jar：写入 Main-Class、合并 services，并排除签名文件 -->
	    <plugin>
	      <groupId>org.apache.maven.plugins</groupId>
	      <artifactId>maven-shade-plugin</artifactId>
	      <version>3.6.2</version>
	      <executions>
	        <execution>
	          <phase>package</phase>
	          <goals><goal>shade</goal></goals>
	          <configuration>
	            <createDependencyReducedPom>false</createDependencyReducedPom>
	            <transformers>
	              <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
	                <mainClass>org.abitware.docfinder.App</mainClass>
                    <manifestEntries>
                      <Multi-Release>true</Multi-Release>
                      <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                    </manifestEntries>
	              </transformer>
	              <!-- Tika/Lucene 的 SPI 发现需要合并 META-INF/services -->
	              <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
	            </transformers>
	
	            <!-- 关键：去掉所有依赖里的签名/索引文件，避免 SecurityException -->
	            <filters>
	              <filter>
	                <artifact>*:*</artifact>
	                <excludes>
	                  <exclude>META-INF/*.SF</exclude>
	                  <exclude>META-INF/*.DSA</exclude>
	                  <exclude>META-INF/*.RSA</exclude>
	                  <exclude>META-INF/*.EC</exclude>
	                  <exclude>META-INF/INDEX.LIST</exclude>
	                </excludes>
	              </filter>
	            </filters>
	          </configuration>
	        </execution>
	      </executions>
	    </plugin>
	    <plugin>
	      <groupId>org.apache.maven.plugins</groupId>
	      <artifactId>maven-surefire-plugin</artifactId>
	      <version>3.6.1</version>
	      <configuration>
	        <!-- Fixed test isolation: the forked JVM must run inside target so
	             AppPaths (user.dir/.docfinder) and LegacyMigration (user.home)
	             can never reach the real working/home directory. Isolation
	             args are appended last so they win over external -DargLine. -->
	        <forkCount>1</forkCount>
	        <reuseForks>true</reuseForks>
	        <workingDirectory>${project.build.testOutputDirectory}</workingDirectory>
	        <argLine>${argLine} -Duser.home="${project.build.directory}/test-home"</argLine>
	      </configuration>
	    </plugin>
	  </plugins>
  </build>

</project>
